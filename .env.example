# Leave empty to use the built-in mock API (data lives in localStorage)
VITE_BASE_ENDPOINT=
VITE_API_TIMEOUT=50000

# Google Maps JavaScript API. Without a key the app draws a schematic map
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAP_ID=

# Set both to share live locations across phones (Supabase Realtime broadcast)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
